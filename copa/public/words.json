 "sentences": [
  {
   "start": 0.25,
   "end": 2.415,
   "text": "Acaba de salir el *sorteo de la Copa del Rey."
  },
  {
   "start": 2.775,
   "end": 5.759,
   "text": "Pero / ¿sabías por qué juega en *casa / el equipo *modesto?"
  },
  {
   "start": 6.119,
   "end": 11.746,
   "text": "En la primera eliminatoria entraron {*112|ciento doce} equipos / y se jugaron {*56|cincuenta y seis} partidos a partido *único."
  },
  {
   "start": 12.106,
   "end": 15.809,
   "text": "La regla es clara / juega de *local / el equipo de *menor categoría."
  },
  {
   "start": 16.169,
   "end": 21.508,
   "text": "Para un club humilde / es su campo lleno hasta la *bandera / la *taquilla de su vida / y un *grande pisando su césped."
  },
  {
   "start": 21.868,
   "end": 24.352,
   "text": "Pero aquí viene el *problema / no vale cualquier campo."
  },
  {
   "start": 24.712,
   "end": 30.32,
   "text": "La Federación exige *luz para la tele / *aforo suficiente / y césped natural o artificial de menos de {*8|ocho} *años."
  },
  {
   "start": 30.68,
   "end": 33.225,
   "text": "¿Y si no cumple? / Toca *mudarse a otro estadio."
  },
  {
   "start": 33.585,
   "end": 38.624,
   "text": "Le pasó al Tavernes / un modesto de categoría *regional / recibió al Valencia / en *Mestalla."
  },
  {
   "start": 38.984,
   "end": 42.207,
   "text": "Así que el Valencia jugó de *visitante / en su propio estadio."
  },
  {
   "start": 42.567,
   "end": 47.167,
   "text": "Otros clubes prefieren hacer obras contrarreloj / *gradas supletorias / y *focos nuevos."
  },
  {
   "start": 47.527,
   "end": 49.952,
   "text": "¿Tú qué prefieres? / ¿Campo pequeño o estadio grande?"
  },
  {
   "start": 50.312,
   "end": 53.765,
   "text": "Te leo en los *comentarios / y *sígueme para más curiosidades de fútbol."
  }
 ]
